# Backend environment
ENVIRONMENT="production"
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME"
JWT_SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
CORS_ORIGINS="https://FRONTEND_HOST"

# Frontend build environment (Vite)
VITE_API_BASE_URL="https://API_HOST"

# Development-only opt-in session bootstrap. Leave disabled outside local development.
VITE_DEV_AUTO_SESSION="false"
VITE_DEV_AUTH_USERNAME=""
VITE_DEV_AUTH_PASSWORD=""

# Required only when running the development seed script to create role users.
OBE_SEED_ADMIN_PASSWORD=""
OBE_SEED_FACULTY_PASSWORD=""
OBE_SEED_ADVISOR_PASSWORD=""
OBE_SEED_HOD_PASSWORD=""
